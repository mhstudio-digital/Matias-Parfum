<div class="card" data-nombre="<%- p.tituloCard %>" data-tipo="<%- p.dataTipo %>" data-brand="<%- p.marca %>" data-familia="<%- p.familia %>" data-intensidad="<%- p.intensidad %>" data-duracion="<%- p.duracionHoras %>">
  <a href="<%- p.hrefProducto %>" class="card-image-wrap" aria-label="Ver <%- p.tituloCard %>">
    <img loading="lazy" src="<%- p.imagen %>" alt="<%- p.tituloCard %>" width="400" height="533">
    <div class="card-overlay" aria-hidden="true">
      <span class="card-overlay-btn">Ver perfume</span>
    </div>
  </a>
  <div class="card-body">
    <span class="card-brand"><%- p.marca %></span>
    <h3 class="card-title"><a href="<%- p.hrefProducto %>"><%- p.tituloCard %></a></h3>
    <div class="card-meta">
      <span class="card-familia"><%- p.familia %></span>
      <span class="card-notas"><%- p.notasTexto %></span>
    </div>
    <p class="precio"><%- p.precioTexto %></p>
    <div class="card-buttons">
      <button class="consultar-btn" onclick="consultarPerfume(&#39;<%- p.tituloCard %>&#39;)">Consultar por WhatsApp</button>
    </div>
  </div>
</div>
